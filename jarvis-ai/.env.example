# ============================================================
# JARVIS - Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── Anthropic (Claude) ──────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Interactive Brokers ─────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497 = paper trading, 7496 = live
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=your_account_id

# ── Binance ─────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_TESTNET=false   # set true for testnet

# ── Bitget ──────────────────────────────────────────────────
BITGET_API_KEY=your_bitget_api_key
BITGET_API_SECRET=your_bitget_api_secret
BITGET_PASSPHRASE=your_bitget_passphrase

# ── TradingView ─────────────────────────────────────────────
TRADINGVIEW_WEBHOOK_SECRET=your_webhook_secret

# ── Voice (optional) ────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_voice_id   # e.g. "21m00Tcm4TlvDq8ikWAM" (Rachel)

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://jarvis:jarvis_password@localhost:5432/jarvis

# ── App ─────────────────────────────────────────────────────
JARVIS_SECRET_KEY=change_this_to_a_random_string
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_ENV=production   # development | production

# ── Briefing ────────────────────────────────────────────────
BRIEFING_TIME=07:00     # Local time for daily briefing
BRIEFING_EMAIL=         # Optional: email to send daily briefing to
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
